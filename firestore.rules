rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.role;
    }

    function isAdmin() {
      return signedIn() && userRole() in ["admin", "Admin", "ADMIN"];
    }

    function isFaculty() {
      return signedIn() && userRole() in ["faculty", "Faculty", "FACULTY"];
    }

    function isOwnUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function immutableUserFieldsUnchanged() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role;
    }

    // Compatibility for the current web client. These progress/result fields
    // are written directly by the browser and are therefore not tamper-proof.
    function editableUserFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "firstName",
        "middleName",
        "middleInitial",
        "lastName",
        "gender",
        "birthday",
        "program",
        "contactNumber",
        "avatarUrl",
        "moduleProgress",
        "practicalTests",
        "accountAchievements",
        "updatedAt"
      ]);
    }

    // Compatibility for the current mobile quiz/practice payload.
    function scoreFieldsAreAllowed() {
      return request.resource.data.keys().hasOnly([
          "moduleId",
          "moduleName",
          "testType",
          "practiceId",
          "title",
          "score",
          "total",
          "percentage",
          "completed",
          "timestamp"
        ])
        && (!("score" in request.resource.data)
          || request.resource.data.score is int
          || request.resource.data.score is float)
        && (!("total" in request.resource.data)
          || request.resource.data.total is int
          || request.resource.data.total is float)
        && (!("percentage" in request.resource.data)
          || request.resource.data.percentage is int
          || request.resource.data.percentage is float);
    }

    function scoreChangedFieldsAreAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "moduleId",
        "moduleName",
        "testType",
        "practiceId",
        "title",
        "score",
        "total",
        "percentage",
        "completed",
        "timestamp"
      ]);
    }

    function isValidNewScorePayload(uid) {
      return isOwnUser(uid) && scoreFieldsAreAllowed();
    }

    function isValidUpdatedScorePayload(uid) {
      return isOwnUser(uid)
        && scoreFieldsAreAllowed()
        && scoreChangedFieldsAreAllowed();
    }

    function isValidSupportTicket() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          "name",
          "email",
          "subject",
          "message",
          "screenshotURL",
          "status",
          "createdAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.subject is string
        && request.resource.data.message is string
        && request.resource.data.screenshotURL is string
        && request.resource.data.status == "open"
        && request.resource.data.createdAt == request.time;
    }

    function isValidModuleChangeRequest() {
      return isFaculty()
        && request.resource.data.keys().hasOnly([
          "moduleId",
          "moduleTitle",
          "summary",
          "status",
          "requestedBy",
          "requestedByEmail",
          "createdAt",
          "cards"
        ])
        && request.resource.data.moduleId in [
          "module_1",
          "module_2",
          "module_3",
          "module_4"
        ]
        && request.resource.data.moduleTitle is string
        && request.resource.data.summary is string
        && request.resource.data.status == "pending"
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.requestedByEmail == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.cards is list
        && request.resource.data.cards.size() > 0
        && request.resource.data.cards.size() <= 30;
    }

    function isValidModuleChangeReview() {
      return isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "reviewedBy",
          "reviewedAt"
        ])
        && resource.data.status == "pending"
        && request.resource.data.status in ["approved", "rejected"]
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;
    }

    function isValidUserActivity() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          "uid",
          "name",
          "email",
          "module",
          "minutes",
          "createdAt"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.module is string
        && request.resource.data.minutes is int
        && request.resource.data.minutes > 0
        && request.resource.data.createdAt == request.time;
    }

    match /otp_challenges/{uid} {
      allow read, write: if false;
    }

    match /otp_sessions/{uid} {
      allow read, write: if false;
    }

    match /assessment_answer_keys/{document=**} {
      allow read, write: if false;
    }

    match /assessment_questions/{document=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /assessment_definitions/{definitionId} {
      allow read, write: if isAdmin();
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == "student";

      allow read: if isAdmin() || isFaculty() || isOwnUser(uid);

      allow update: if (isAdmin() || isOwnUser(uid))
        && immutableUserFieldsUnchanged()
        && editableUserFieldsOnly();

      allow delete: if false;

      match /module_scores/{scoreId} {
        allow read: if isAdmin() || isFaculty() || isOwnUser(uid);
        allow create: if isValidNewScorePayload(uid);
        allow update: if isValidUpdatedScorePayload(uid);
        allow delete: if false;
      }

      match /practice_scores/{scoreId} {
        allow read: if isAdmin() || isFaculty() || isOwnUser(uid);
        allow create: if isValidNewScorePayload(uid);
        allow update: if isValidUpdatedScorePayload(uid);
        allow delete: if false;
      }

      // Legacy mobile score collections consumed by the score dashboard.
      match /{scoreCollection}/{scoreId} {
        allow read: if scoreCollection in ["scores", "mobileScores", "studentScores", "quizScores", "practicalScores"]
          && (isOwnUser(uid) || isAdmin() || isFaculty());
      }

      match /assessment_attempts/{attemptId} {
        allow read: if isAdmin() || isFaculty() || isOwnUser(uid);
        allow create, update, delete: if false;
      }
    }

    match /userActivities/{activityId} {
      allow create: if isValidUserActivity();
      allow read: if isAdmin() || isFaculty();
      allow update, delete: if false;
    }

    match /module_content_cards/{cardId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /module_change_requests/{requestId} {
      allow create: if isValidModuleChangeRequest();

      allow read: if isAdmin()
        || (
          isFaculty()
          && resource.data.requestedBy == request.auth.uid
        );

      allow update: if isValidModuleChangeReview();
      allow delete: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow create: if isValidSupportTicket();
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
