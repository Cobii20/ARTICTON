rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.role;
    }

    function isAdmin() {
      return signedIn() && userRole() in ["admin", "Admin", "ADMIN"];
    }

    function isFaculty() {
      return signedIn() && userRole() in ["faculty", "Faculty", "FACULTY"];
    }

    function isOwnUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function immutableUserFieldsUnchanged() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role;
    }

    function editableUserFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "firstName",
        "middleName",
        "middleInitial",
        "lastName",
        "gender",
        "birthday",
        "program",
        "contactNumber",
        "updatedAt"
      ])
      && request.resource.data.firstName is string && request.resource.data.firstName.size() <= 80
      && request.resource.data.lastName is string && request.resource.data.lastName.size() <= 80
      && request.resource.data.get("middleName", "") is string && request.resource.data.get("middleName", "").size() <= 80
      && request.resource.data.get("middleInitial", "") is string && request.resource.data.get("middleInitial", "").size() <= 5
      && request.resource.data.get("gender", "") is string && request.resource.data.get("gender", "").size() <= 30
      && request.resource.data.get("birthday", "") is string && request.resource.data.get("birthday", "").size() <= 20
      && request.resource.data.get("program", "") is string && request.resource.data.get("program", "").size() <= 100
      && request.resource.data.get("contactNumber", "") is string && request.resource.data.get("contactNumber", "").size() <= 30
      && request.resource.data.updatedAt == request.time;
    }

    // Compatibility for the current mobile quiz/practice payload.
    function scoreFieldsAreAllowed() {
      return request.resource.data.keys().hasOnly([
          "moduleId",
          "moduleName",
          "testType",
          "practiceId",
          "title",
          "score",
          "total",
          "percentage",
          "completed",
          "timestamp"
        ])
        && (!("score" in request.resource.data)
          || request.resource.data.score is int
          || request.resource.data.score is float)
        && (!("total" in request.resource.data)
          || request.resource.data.total is int
          || request.resource.data.total is float)
        && (!("percentage" in request.resource.data)
          || request.resource.data.percentage is int
          || request.resource.data.percentage is float);
    }

    function scoreChangedFieldsAreAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "moduleId",
        "moduleName",
        "testType",
        "practiceId",
        "title",
        "score",
        "total",
        "percentage",
        "completed",
        "timestamp"
      ]);
    }

    function isValidSupportTicket() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          "name",
          "email",
          "subject",
          "message",
          "screenshotURL",
          "status",
          "createdAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0 && request.resource.data.subject.size() <= 160
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 5000
        && request.resource.data.screenshotURL is string
        && request.resource.data.screenshotURL.size() <= 1000
        && request.resource.data.status == "open"
        && request.resource.data.createdAt == request.time;
    }

    function isValidSupportTicketUpdate() {
      return isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        && request.resource.data.status in ["open", "in_progress", "resolved"];
    }

    function isValidModuleChangeRequest() {
      return isFaculty()
        && request.resource.data.keys().hasOnly([
          "moduleId",
          "moduleTitle",
          "summary",
          "status",
          "requestedBy",
          "requestedByEmail",
          "createdAt",
          "cards"
        ])
        && request.resource.data.moduleId in [
          "module_1",
          "module_2",
          "module_3",
          "module_4"
        ]
        && request.resource.data.moduleTitle is string
        && request.resource.data.summary is string
        && request.resource.data.status == "pending"
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.requestedByEmail == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.cards is list
        && request.resource.data.cards.size() > 0
        && request.resource.data.cards.size() <= 30;
    }

    function isValidModuleChangeReview() {
      return isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "reviewedBy",
          "reviewedAt"
        ])
        && resource.data.status == "pending"
        && request.resource.data.status in ["approved", "rejected"]
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;
    }

    function isValidUserActivity() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          "uid",
          "name",
          "email",
          "module",
          "minutes",
          "createdAt"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.module is string
        && request.resource.data.minutes is int
        && request.resource.data.minutes > 0
        && request.resource.data.createdAt == request.time;
    }

    // Question requests contain complete proposed banks; only admin review publishes them.
    function isQuestionEditor() {
      return signedIn() && userRole() in ["faculty", "Faculty", "FACULTY", "staff", "Staff", "STAFF"];
    }

    function validAssessmentId(id) {
      return id in ["module_1_pre_test", "module_1_post_test", "module_2_pre_test", "module_2_post_test",
        "module_3_pre_test", "module_3_post_test", "module_4_pre_test", "module_4_post_test",
        "practice_exam_1", "practice_exam_2"];
    }

    function publishedRevision(id) {
      let path = /databases/$(database)/documents/published_question_banks/$(id);
      return exists(path) ? get(path).data.revision : 0;
    }

    function validQuestionRequest(data) {
      return data.keys().hasOnly(["assessmentId", "baseRevision", "questionCount", "before", "questions",
          "summary", "status", "requestedBy", "createdAt", "reviewedBy", "reviewedAt"])
        && validAssessmentId(data.assessmentId)
        && data.baseRevision is int && data.baseRevision >= 0
        && data.questions is list && data.questions.size() > 0 && data.questions.size() <= 100
        && data.questionCount is int && data.questionCount == data.questions.size()
        && data.before is list && data.before.size() == data.questionCount
        && data.summary is string && data.summary.matches('(?s).*[^ \t\r\n].*') && data.summary.size() <= 5000
        && data.requestedBy is string && data.createdAt is timestamp
        && data.status in ["pending", "approved", "rejected"];
    }

    function validNewQuestionRequest() {
      let data = request.resource.data;
      let path = /databases/$(database)/documents/published_question_banks/$(data.assessmentId);
      return isQuestionEditor() && validQuestionRequest(data)
        && data.status == "pending" && data.requestedBy == request.auth.uid
        && data.createdAt == request.time
        && data.get("reviewedBy", null) == null && data.get("reviewedAt", null) == null
        && data.baseRevision == publishedRevision(data.assessmentId)
        && (!exists(path) || data.before == get(path).data.questions);
    }

    function validQuestionReview(requestId) {
      let data = request.resource.data;
      let bank = /databases/$(database)/documents/published_question_banks/$(data.assessmentId);
      return isAdmin() && validQuestionRequest(data)
        && data.diff(resource.data).affectedKeys().hasOnly(["status", "reviewedBy", "reviewedAt"])
        && resource.data.status == "pending" && data.status in ["approved", "rejected"]
        && data.reviewedBy == request.auth.uid && data.reviewedAt == request.time
        && (data.status == "rejected" || (
          data.baseRevision == publishedRevision(data.assessmentId)
          && getAfter(bank).data.revision == data.baseRevision + 1
          && getAfter(bank).data.sourceRequestId == requestId
          && getAfter(bank).data.questions == data.questions
          && getAfter(bank).data.approvedBy == request.auth.uid
          && getAfter(bank).data.approvedAt == request.time
        ));
    }

    function validPublishedBank(assessmentId) {
      let data = request.resource.data;
      let change = /databases/$(database)/documents/question_change_requests/$(data.sourceRequestId);
      return isAdmin() && validAssessmentId(assessmentId)
        && data.keys().hasOnly(["questions", "revision", "sourceRequestId", "approvedBy", "approvedAt"])
        && data.questions is list && data.questions.size() > 0 && data.questions.size() <= 100
        && data.revision is int && data.revision == publishedRevision(assessmentId) + 1
        && data.sourceRequestId is string
        && data.approvedBy == request.auth.uid && data.approvedAt == request.time
        && get(change).data.status == "pending"
        && get(change).data.assessmentId == assessmentId
        && get(change).data.baseRevision == data.revision - 1
        && getAfter(change).data.status == "approved"
        && getAfter(change).data.reviewedBy == request.auth.uid
        && getAfter(change).data.reviewedAt == request.time
        && getAfter(change).data.questions == data.questions;
    }

    match /question_change_requests/{requestId} {
      allow read: if isAdmin() || (isQuestionEditor() && resource.data.requestedBy == request.auth.uid);
      allow create: if validNewQuestionRequest();
      allow update: if validQuestionReview(requestId);
      allow delete: if false;
    }

    match /published_question_banks/{assessmentId} {
      allow read: if signedIn();
      allow create, update: if validPublishedBank(assessmentId);
      allow delete: if false;
    }

    match /otp_challenges/{uid} {
      allow read, write: if false;
    }

    match /otp_sessions/{uid} {
      allow read, write: if false;
    }

    match /assessment_answer_keys/{document=**} {
      allow read, write: if false;
    }

    match /assessment_questions/{document=**} {
      // Legacy source data is not student-facing. New attempts use only the
      // approved published_question_banks document for their assessment.
      allow read: if isAdmin() || isQuestionEditor();
      allow write: if isAdmin();
    }

    match /assessment_definitions/{definitionId} {
      allow read, write: if isAdmin();
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["uid", "email", "role", "firstName", "lastName", "middleName", "gender", "birthday", "program", "contactNumber", "updatedAt", "createdAt"])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "student"
        && request.resource.data.firstName is string && request.resource.data.firstName.size() > 0 && request.resource.data.firstName.size() <= 80
        && request.resource.data.lastName is string && request.resource.data.lastName.size() > 0 && request.resource.data.lastName.size() <= 80
        && request.resource.data.get("middleName", "") is string && request.resource.data.get("middleName", "").size() <= 80
        && request.resource.data.get("gender", "") is string && request.resource.data.get("gender", "").size() <= 30
        && request.resource.data.get("birthday", "") is string && request.resource.data.get("birthday", "").size() <= 20
        && request.resource.data.get("program", "") is string && request.resource.data.get("program", "").size() <= 100
        && request.resource.data.get("contactNumber", "") is string && request.resource.data.get("contactNumber", "").size() <= 30
        && request.resource.data.updatedAt == request.time && request.resource.data.createdAt == request.time;

      allow read: if isAdmin() || isOwnUser(uid);

      allow update: if (isAdmin() || isOwnUser(uid))
        && immutableUserFieldsUnchanged()
        && editableUserFieldsOnly();

      allow delete: if false;

      match /module_scores/{scoreId} {
        allow read: if isAdmin() || isFaculty() || isOwnUser(uid);
        allow write: if false;
      }

      match /practice_scores/{scoreId} {
        allow read: if isAdmin() || isFaculty() || isOwnUser(uid);
        allow write: if false;
      }

      // Legacy mobile score collections consumed by the score dashboard.
      match /{scoreCollection}/{scoreId} {
        allow read: if scoreCollection in ["scores", "mobileScores", "studentScores", "quizScores", "practicalScores"]
          && (isOwnUser(uid) || isAdmin() || isFaculty());
      }

      match /assessment_attempts/{attemptId} {
        allow read: if isAdmin() || isFaculty() || isOwnUser(uid);
        allow create, update, delete: if false;
      }

      match /practical_attempts/{attemptId} {
        allow read: if isAdmin() || isFaculty() || isOwnUser(uid);
        allow write: if false;
      }

      match /practical_results/{resultId} {
        allow read: if isAdmin() || isFaculty() || isOwnUser(uid);
        allow write: if false;
      }

      match /achievements/{achievementId} {
        allow read: if isAdmin() || isFaculty() || isOwnUser(uid);
        allow write: if false;
      }
    }

    match /student_summaries/{uid} {
      allow read: if isAdmin() || isFaculty() || isOwnUser(uid);
      allow write: if false;
    }

    match /function_rate_limits/{limitId} {
      allow read, write: if false;
    }

    match /userActivities/{activityId} {
      allow create: if isValidUserActivity();
      allow read: if isAdmin() || isFaculty();
      allow update, delete: if false;
    }

    match /module_content_cards/{cardId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /module_change_requests/{requestId} {
      allow create: if isValidModuleChangeRequest();

      allow read: if isAdmin()
        || (
          isFaculty()
          && resource.data.requestedBy == request.auth.uid
        );

      allow update: if isValidModuleChangeReview();
      allow delete: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow create: if isValidSupportTicket();
      allow read: if isAdmin();
      allow update: if isValidSupportTicketUpdate();
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
