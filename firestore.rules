rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasVerifiedOtp() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/otp_sessions/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/otp_sessions/$(request.auth.uid)
        ).data.uid == request.auth.uid
        && get(
          /databases/$(database)/documents/otp_sessions/$(request.auth.uid)
        ).data.authTime == request.auth.token.auth_time
        && get(
          /databases/$(database)/documents/otp_sessions/$(request.auth.uid)
        ).data.expiresAt > request.time;
    }

    function userRole() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.role;
    }

    function isAdmin() {
      return hasVerifiedOtp() && userRole() in ["admin", "Admin", "ADMIN"];
    }

    function isFaculty() {
      return hasVerifiedOtp() && userRole() in ["faculty", "Faculty", "FACULTY"];
    }

    function isOwnUser(uid) {
      return hasVerifiedOtp() && request.auth.uid == uid;
    }

    match /otp_challenges/{uid} {
      allow read, write: if false;
    }

    match /otp_sessions/{uid} {
      allow read, write: if false;
    }

    match /assessment_answer_keys/{document=**} {
      allow read, write: if false;
    }

    match /assessment_questions/{document=**} {
      allow read: if hasVerifiedOtp();
      allow write: if isAdmin();
    }

    match /assessment_definitions/{definitionId} {
      allow read, write: if isAdmin();
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == "student";

      allow read: if isAdmin() || isFaculty() || isOwnUser(uid);

      allow update: if isAdmin()
        || (
          isOwnUser(uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "firstName",
            "middleName",
            "lastName",
            "gender",
            "birthday",
            "program",
            "contactNumber",
            "moduleProgress",
            "updatedAt"
          ])
        );

      allow delete: if false;

      match /module_scores/{scoreId} {
        allow read: if isAdmin() || isFaculty() || isOwnUser(uid);
        allow create, update, delete: if false;
      }

      match /practice_scores/{scoreId} {
        allow read: if isAdmin() || isFaculty() || isOwnUser(uid);
        allow create, update, delete: if false;
      }

      match /assessment_attempts/{attemptId} {
        allow read: if isAdmin() || isFaculty() || isOwnUser(uid);
        allow create, update, delete: if false;
      }
    }

    match /module_content_cards/{cardId} {
      allow read: if hasVerifiedOtp();
      allow create, update, delete: if isAdmin();
    }

    match /module_change_requests/{requestId} {
      allow create: if isFaculty()
        && request.resource.data.status == "pending"
        && request.resource.data.requestedBy == request.auth.uid;

      allow read: if isAdmin()
        || (
          isFaculty()
          && resource.data.requestedBy == request.auth.uid
        );

      allow update: if isAdmin()
        && request.resource.data.status in ["approved", "rejected"];

      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
