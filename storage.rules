rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /profile-photos/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /supportTickets/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Disabled until a trusted backend validates decoded file bytes and
      // publishes a clean object. Client-provided MIME metadata is insufficient.
      allow create, update, delete: if false;
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
